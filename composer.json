{
    "name": "sylius/gmv-bundle",
    "description": "Lightweight local command to calculate the Sylius instance GMV within a specific period",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
    ],
    "autoload": {
        "psr-4": {
            "Sylius\\GmvBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Sylius\\GmvBundle\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/dependency-injection": "^6.4 || ^7.1 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/console": "^6.4 || ^7.1 || ^8.0",
        "sylius/core-bundle": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "lchrusciel/api-test-case": "^5.3 || ^6.0",
        "sylius-labs/coding-standard": "^4.5",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "symfony/security-bundle": "^6.4 || ^7.1 || ^8.0"
    },
    "extra": {
        "symfony": {
            "require": "^6.4"
        },
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
